# --- Tryb pracy aplikacji ---
# supabase = pełny backend (auth + PostgreSQL + Storage)  |  demo = praca w 100% lokalna (IndexedDB), bez konta
# Gdy poniższe wartości są puste, aplikacja sama przechodzi w tryb demo.
VITE_APP_MODE=auto

# --- Supabase (Utwórz w: Dashboard → Settings → API) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Klucz service_role NIE jest potrzebny w przeglądarce i nigdy nie trafiaj do repozytorium.
